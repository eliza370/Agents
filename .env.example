# Copy this file to .env and fill in your key.
# .env is gitignored — never commit a real key.
#
# No VITE_ prefix: this key is read server-side by vite.config.js and
# injected into the /api/claude proxy request. A VITE_ prefix would make
# Vite bundle it into the browser JavaScript, defeating the point.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
